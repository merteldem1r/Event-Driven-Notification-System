#!/bin/sh
#
# commit-msg hook: enforce the Conventional Commits format on the first line.
#
#   <type>(<optional scope>)<optional !>: <description>
#
#   feat: add batch endpoint
#   fix(worker): retry on provider timeout
#   docs: explain rate limiting
#
# Git runs this with the path of the commit message file as $1.
# CI (.github/workflows/commit-messages.yml) reuses this script, so the rule
# lives in one place.
#
# Enable locally with: make hooks

msg_file="$1"

# First line that isn't a Git comment.
header=$(grep -v '^#' "$msg_file" | head -n 1)

# Messages generated by Git itself are allowed through.
case "$header" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"
max_length=72

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
✖ Commit message must follow Conventional Commits.

  Got:      $header
  Expected: <type>(<optional scope>): <description>
  Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

  Examples: feat: add batch endpoint
            fix(worker): retry on provider timeout
            docs: explain rate limiting
EOF
  exit 1
fi

if [ "${#header}" -gt "$max_length" ]; then
  echo "✖ First line is ${#header} characters; keep it at $max_length or fewer." >&2
  exit 1
fi
