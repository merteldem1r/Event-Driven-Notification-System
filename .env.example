# Local settings for running the API and the worker on your Mac (make run-api, make run-worker,
# go run, or your IDE).
#
#   cp .env.example .env.local     then edit .env.local (it is gitignored)
#
# Both programs read .env.local at startup. Variables already set in your terminal win over the file.
# Docker Compose does not use this file; containers are configured in docker-compose.yml.
# Compose sends to its own fake provider; to use webhook.site there, put PROVIDER_URL in a
# file named .env next to docker-compose.yml instead.

# Port the API listens on. Default: 8080.
HTTP_PORT=8080

# Log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# PostgreSQL connection string. Required.
# Port 5433 = the Compose database published on your Mac (start it with `make infra-up`).
DATABASE_URL=postgres://notification:notification@localhost:5433/notification?sslmode=disable

# ---- Worker only ----

# Loops per channel in each worker process, 1 to 1000. Default: 10 (so 30 loops for sms, email, push).
# Each channel has its own loops, so a backlog on one channel never holds up the others (D16).
# Roughly rate limit x provider latency: 100/s x 0.1 s = 10.
WORKER_CONCURRENCY=10

# How long an idle loop waits before checking the queue again (Go duration). Default: 500ms.
WORKER_POLL_INTERVAL=500ms

# After Ctrl+C or SIGTERM, how long in-flight sends may take to finish (Go duration). Default: 25s.
WORKER_SHUTDOWN_TIMEOUT=25s

# How long a claimed notification belongs to its worker before another may take it over
# (Go duration). Must be longer than PROVIDER_TIMEOUT. Default: 60s. The final number is decision D8 (Phase 8).
WORKER_LEASE_DURATION=60s

# Where the worker sends notifications (D9). Required by the worker. Either:
#  - the local fake provider: http://localhost:9090/  (start it with `make run-fakeprovider`), or
#  - your own webhook.site URL. On webhook.site, click Edit and set: status 202, content type
#    application/json, body {"messageId": "<any id>", "status": "accepted", "timestamp": "2026-11-20T10:00:00Z"}
#    Keep that URL private: anyone with it can read what is sent there.
PROVIDER_URL=http://localhost:9090/

# Time limit for one send to the provider (Go duration). Default: 5s.
PROVIDER_TIMEOUT=5s

# Waits between attempts after a temporary failure (D8): RETRY_BASE_DELAY after the first,
# doubling each time up to RETRY_MAX_DELAY, then picked at random between half and all of it.
# A provider's Retry-After is used when longer, also up to RETRY_MAX_DELAY. Go durations.
# Defaults: 10s and 10m, i.e. 5-10s, 10-20s, 20-40s, 40-80s, ...
RETRY_BASE_DELAY=10s
RETRY_MAX_DELAY=10m

# Redis holding the shared rate limiter (D2). Required by the worker.
# Port 6379 = the Compose Redis published on your Mac.
REDIS_URL=redis://localhost:6379/0

# Sends per second per channel, for all worker processes together, 1 to 100000. Default: 85.
# At most RATE_LIMIT_PER_SECOND + RATE_LIMIT_BURST leave in any one second (here 90), set below
# the provider's limit of 100 because the machine and network can still bunch messages up a
# little on the way (D17). Measured with 5 workers: at most 93 arrived in any one second.
RATE_LIMIT_PER_SECOND=85

# Sends allowed at once after a quiet moment, 1 to RATE_LIMIT_PER_SECOND. Default: 5 (D15).
# A little allowance absorbs the few milliseconds a loop is late for its slot; with 1, about
# 10% of the slots were lost.
RATE_LIMIT_BURST=5

# ---- Fake provider only (cmd/fakeprovider) ----

# Port the fake provider listens on. Default: 9090.
FAKE_PROVIDER_PORT=9090

# How long each answer takes, like a real provider's network and processing time (0s to 1m). Default: 50ms.
FAKE_PROVIDER_LATENCY=50ms

# Share of requests answered 503 Service Unavailable, from 0 to 1 (0.1 = 10%). Default: 0.
FAKE_PROVIDER_FAILURE_RATE=0
