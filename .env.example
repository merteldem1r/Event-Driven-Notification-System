# Local settings for running the API and the worker on your Mac (make run-api, make run-worker,
# go run, or your IDE).
#
#   cp .env.example .env.local     then edit .env.local (it is gitignored)
#
# Both programs read .env.local at startup. Variables already set in your terminal win over the file.
# Docker Compose does not use this file; containers are configured in docker-compose.yml.
# For Compose, put PROVIDER_URL in a file named .env next to docker-compose.yml instead.

# Port the API listens on. Default: 8080.
HTTP_PORT=8080

# Log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# PostgreSQL connection string. Required.
# Port 5433 = the Compose database published on your Mac (start it with `make infra-up`).
DATABASE_URL=postgres://notification:notification@localhost:5433/notification?sslmode=disable

# ---- Worker only ----

# Loops per channel in each worker process, 1 to 1000. Default: 10 (so 30 loops for sms, email, push).
# Each channel has its own loops, so a backlog on one channel never holds up the others (D16).
# Roughly rate limit x provider latency: 100/s x 0.1 s = 10.
WORKER_CONCURRENCY=10

# How long an idle loop waits before checking the queue again (Go duration). Default: 500ms.
WORKER_POLL_INTERVAL=500ms

# After Ctrl+C or SIGTERM, how long in-flight sends may take to finish (Go duration). Default: 25s.
WORKER_SHUTDOWN_TIMEOUT=25s

# How long a claimed notification belongs to its worker before another may take it over
# (Go duration). Must be longer than PROVIDER_TIMEOUT. Default: 60s. The final number is decision D8 (Phase 8).
WORKER_LEASE_DURATION=60s

# Where the worker sends notifications: your own webhook.site URL (D9). Required by the worker.
# On webhook.site, click Edit and set: status 202, content type application/json, body
#   {"messageId": "<any id>", "status": "accepted", "timestamp": "2026-11-20T10:00:00Z"}
# Keep the URL private: anyone with it can read what is sent there.
PROVIDER_URL=

# Time limit for one send to the provider (Go duration). Default: 5s.
PROVIDER_TIMEOUT=5s

# Redis holding the shared rate limiter (D2). Port 6379 = the Compose Redis published on your Mac.
REDIS_URL=redis://localhost:6379/0

# Sends per second per channel, for all worker processes together, 1 to 100000. Default: 100.
RATE_LIMIT_PER_SECOND=100

# Sends allowed at once after a quiet moment, 1 to RATE_LIMIT_PER_SECOND. Default: 10 (D15).
# Never more than RATE_LIMIT_PER_SECOND + RATE_LIMIT_BURST go out in any one second.
RATE_LIMIT_BURST=10
