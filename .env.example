# Local settings for running the API and the worker on your Mac (make run-api, make run-worker,
# go run, or your IDE).
#
#   cp .env.example .env.local     then edit .env.local (it is gitignored)
#
# Both programs read .env.local at startup. Variables already set in your terminal win over the file.
# Docker Compose does not use this file; containers are configured in docker-compose.yml.

# Port the API listens on. Default: 8080.
HTTP_PORT=8080

# Log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# PostgreSQL connection string. Required.
# Port 5433 = the Compose database published on your Mac (start it with `make infra-up`).
DATABASE_URL=postgres://notification:notification@localhost:5433/notification?sslmode=disable

# ---- Worker only ----

# Notifications processed in parallel per worker process, 1 to 1000. Default: 30.
# Roughly target rate x provider latency: 300/s x 0.1 s = 30.
WORKER_CONCURRENCY=30

# How long an idle loop waits before checking the queue again (Go duration). Default: 500ms.
WORKER_POLL_INTERVAL=500ms

# After Ctrl+C or SIGTERM, how long in-flight sends may take to finish (Go duration). Default: 25s.
WORKER_SHUTDOWN_TIMEOUT=25s

# How long a claimed notification belongs to its worker before another may take it over
# (Go duration). Default: 60s. The final number is decision D8 (Phase 8).
WORKER_LEASE_DURATION=60s
